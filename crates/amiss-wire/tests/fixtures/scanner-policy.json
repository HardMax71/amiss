{
  "schema": "amiss/scanner-policy",
  "document_includes": [
    { "path": "docs/adr", "kind": "tree", "suffix": ".txt", "adapter": "rst" },
    { "path": "docs/spec.rst", "kind": "document" }
  ],
  "projection_assertions": [
    {
      "document": "docs/architecture.md",
      "name": "request-shape",
      "projection": "code-text-v1",
      "sink": "previous-code",
      "source": {
        "kind": "blob-lines",
        "path": "crates/amiss/src/request.rs",
        "first_line": 10,
        "last_line": 14
      }
    },
    {
      "document": "docs/generated.md",
      "name": "generated-shape",
      "projection": "code-text-v1",
      "sink": "previous-code",
      "source": {
        "kind": "named-region",
        "path": "examples/generated.txt",
        "start_marker": "// amiss:generated:start",
        "end_marker": "// amiss:generated:end"
      }
    }
  ],
  "protected_inventory": [
    "README.md",
    "docs/architecture.md"
  ],
  "finding_dispositions": [
    { "finding_kind": "explicit-target-missing", "disposition": "fail" }
  ]
}
