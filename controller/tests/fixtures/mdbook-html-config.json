{
  "theme":"theme",
  "default-theme":"light",
  "preferred-dark-theme":"navy",
  "smart-punctuation":false,
  "definition-lists":true,
  "admonitions":true,
  "mathjax-support":false,
  "additional-css":["custom.css"],
  "additional-js":["custom.js"],
  "fold":{"enable":true,"level":255},
  "playpen":{"editable":true,"copyable":false,"copy-js":true,"line-numbers":false,"runnable":true},
  "code":{"hidelines":{"rust":"#"}},
  "print":{"enable":true,"page-break":false},
  "no-section-label":true,
  "search":{
    "enable":true,
    "limit-results":4294967295,
    "teaser-word-count":30,
    "use-boolean-and":true,
    "boost-title":255,
    "boost-hierarchy":2,
    "boost-paragraph":1,
    "expand":false,
    "heading-split-level":3,
    "copy-js":true,
    "chapter":{"intro.md":{"enable":false}}
  },
  "git-repository-url":"https://example.com/repo",
  "git-repository-icon":"fa-git",
  "input-404":"404.md",
  "site-url":"https://example.com/",
  "cname":"book.example.com",
  "edit-url-template":"https://example.com/{path}",
  "live-reload-endpoint":"reload",
  "redirect":{"old.html":"new.html"},
  "hash-files":false,
  "sidebar-header-nav":true
}
