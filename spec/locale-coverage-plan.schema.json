{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amiss:schema:locale-coverage-plan",
  "title": "Amiss locale coverage plan",
  "description": "One operator-owned, report-bound plan for comparing source and target page-key inventories, authorizing source fallback, optionally requiring exact target-to-source lineage, and optionally selecting one immutable product resource both locales must describe. It selects policy; it does not assert that inventories exist, pages are translated, or provenance, lineage, and publication alignment are valid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "payload_digest", "schema"],
  "properties": {
    "schema": {
      "const": "amiss/locale-coverage-plan-envelope"
    },
    "payload": {
      "$ref": "#/$defs/PlanPayload"
    },
    "payload_digest": {
      "description": "The domain-separated digest of the canonical payload bytes under the locale-coverage-plan payload schema identity.",
      "$ref": "#/$defs/Digest"
    }
  },
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ResourceUri": {
      "description": "An exact absolute resource URI. The accompanying digest, not the URI spelling, establishes immutable bytes.",
      "type": "string",
      "minLength": 3,
      "maxLength": 16384,
      "pattern": "^[a-z][a-z0-9+.-]*:[^#\\s]+$"
    },
    "Resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "uri"],
      "properties": {
        "uri": {
          "$ref": "#/$defs/ResourceUri"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "ArtifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "OpenIdentity": {
      "description": "An opaque producer-owned locale, version, or producer-version label. Amiss compares it exactly and assigns it no ordering or BCP 47 meaning.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "PageKey": {
      "description": "One opaque stable page identity emitted by the selected producer, not a route inferred by Amiss. Named keys are byte-sorted and unique.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\p{Cc}]+$"
    },
    "Repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "name", "owner"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,98}[a-z0-9])?(?:/[a-z0-9](?:[a-z0-9._-]{0,98}[a-z0-9])?)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,98}[a-z0-9])?$",
          "not": {
            "enum": [".", ".."]
          }
        }
      }
    },
    "DocsCandidate": {
      "description": "The exact committed docs source and scanner candidate identity whose report selected this audit.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_identity_digest",
        "commit_oid",
        "object_format",
        "repository",
        "tree_oid"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/Repository"
        },
        "object_format": {
          "enum": ["sha1", "sha256"]
        },
        "commit_oid": {
          "type": "string"
        },
        "tree_oid": {
          "type": "string"
        },
        "candidate_identity_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "object_format": {
                "const": "sha1"
              }
            }
          },
          "then": {
            "properties": {
              "commit_oid": {
                "pattern": "^[0-9a-f]{40}$"
              },
              "tree_oid": {
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "object_format": {
                "const": "sha256"
              }
            }
          },
          "then": {
            "properties": {
              "commit_oid": {
                "pattern": "^[0-9a-f]{64}$"
              },
              "tree_oid": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "Scope": {
      "description": "The independently selected site, locale pair, channel, and optional version. Source and target locale must differ.",
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "site", "source_locale", "target_locale", "version"],
      "properties": {
        "site": {
          "$ref": "#/$defs/ArtifactId"
        },
        "source_locale": {
          "$ref": "#/$defs/OpenIdentity"
        },
        "target_locale": {
          "$ref": "#/$defs/OpenIdentity"
        },
        "channel": {
          "$ref": "#/$defs/ArtifactId"
        },
        "version": {
          "oneOf": [
            {
              "$ref": "#/$defs/OpenIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Producer": {
      "description": "The independently selected page-inventory producer and exact context it must later reproduce.",
      "type": "object",
      "additionalProperties": false,
      "required": ["context_digest", "identity", "version"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/ArtifactId"
        },
        "version": {
          "$ref": "#/$defs/OpenIdentity"
        },
        "context_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "Requirement": {
      "description": "A source-page selector. All-source selects every source page key. Named selects only the listed keys.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "const": "all-source"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["keys", "mode"],
          "properties": {
            "mode": {
              "const": "named"
            },
            "keys": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/PageKey"
              }
            }
          }
        }
      ]
    },
    "FallbackRule": {
      "description": "One operator-authorized fallback class and the source page keys on which that class may appear. Rules are byte-sorted and unique by class.",
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "pages"],
      "properties": {
        "class": {
          "$ref": "#/$defs/ArtifactId"
        },
        "pages": {
          "$ref": "#/$defs/Requirement"
        }
      }
    },
    "Policy": {
      "description": "The operator-owned coverage, fallback, and lineage rule. The context digest binds rule bytes interpreted outside Amiss.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_digest",
        "fallbacks",
        "identity",
        "require_target_lineage",
        "required"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/ArtifactId"
        },
        "context_digest": {
          "$ref": "#/$defs/Digest"
        },
        "required": {
          "$ref": "#/$defs/Requirement"
        },
        "require_target_lineage": {
          "description": "When true, every observed target-owned page whose source is available must carry the exact source resource digest it was based on. Fallback rows already carry their exact F02 source binding.",
          "type": "boolean"
        },
        "fallbacks": {
          "description": "The byte-sorted set of fallback rules, unique by class. An empty set forbids every fallback.",
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/FallbackRule"
          }
        }
      }
    },
    "PlanPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docs",
        "policy",
        "producer",
        "product",
        "report_payload_digest",
        "schema",
        "scope"
      ],
      "properties": {
        "schema": {
          "const": "amiss/locale-coverage-plan-payload"
        },
        "report_payload_digest": {
          "description": "The verified scanner report whose exact docs candidate selected this later coverage audit.",
          "$ref": "#/$defs/Digest"
        },
        "docs": {
          "$ref": "#/$defs/DocsCandidate"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "product": {
          "description": "The exact immutable product both locale inventories must independently identify, or null when this audit does not claim product-release alignment. The opaque scope version is never a substitute.",
          "oneOf": [
            {
              "$ref": "#/$defs/Resource"
            },
            {
              "type": "null"
            }
          ]
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        }
      }
    }
  }
}
