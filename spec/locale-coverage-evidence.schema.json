{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amiss:schema:locale-coverage-evidence",
  "title": "Amiss locale coverage evidence",
  "description": "One producer-normalized, digest-bound pair of source and target page-key inventories. Each target page declares whether it is target-owned or a source fallback; a target-owned page may bind the exact source resource it was based on. No row proves translation quality or semantic equivalence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "payload_digest", "schema"],
  "properties": {
    "schema": {
      "const": "amiss/locale-coverage-evidence-envelope"
    },
    "payload": {
      "$ref": "#/$defs/EvidencePayload"
    },
    "payload_digest": {
      "description": "The domain-separated digest of the canonical payload bytes under the locale-coverage-evidence payload schema identity.",
      "$ref": "#/$defs/Digest"
    }
  },
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ArtifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "OpenIdentity": {
      "description": "An opaque producer-owned locale, version, or producer-version label compared exactly by Amiss.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "PageKey": {
      "description": "One opaque stable page identity emitted by the selected producer, not a route inferred by Amiss.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\p{Cc}]+$"
    },
    "Repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "name", "owner"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,98}[a-z0-9])?(?:/[a-z0-9](?:[a-z0-9._-]{0,98}[a-z0-9])?)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,98}[a-z0-9])?$",
          "not": {
            "enum": [".", ".."]
          }
        }
      }
    },
    "DocsCandidate": {
      "description": "The exact committed docs source and scanner candidate identity repeated independently by the evidence producer.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_identity_digest",
        "commit_oid",
        "object_format",
        "repository",
        "tree_oid"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/Repository"
        },
        "object_format": {
          "enum": ["sha1", "sha256"]
        },
        "commit_oid": {
          "type": "string"
        },
        "tree_oid": {
          "type": "string"
        },
        "candidate_identity_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "object_format": {
                "const": "sha1"
              }
            }
          },
          "then": {
            "properties": {
              "commit_oid": {
                "pattern": "^[0-9a-f]{40}$"
              },
              "tree_oid": {
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "object_format": {
                "const": "sha256"
              }
            }
          },
          "then": {
            "properties": {
              "commit_oid": {
                "pattern": "^[0-9a-f]{64}$"
              },
              "tree_oid": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "Scope": {
      "description": "The independently observed site, locale pair, channel, and optional version. Source and target locale must differ.",
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "site", "source_locale", "target_locale", "version"],
      "properties": {
        "site": {
          "$ref": "#/$defs/ArtifactId"
        },
        "source_locale": {
          "$ref": "#/$defs/OpenIdentity"
        },
        "target_locale": {
          "$ref": "#/$defs/OpenIdentity"
        },
        "channel": {
          "$ref": "#/$defs/ArtifactId"
        },
        "version": {
          "oneOf": [
            {
              "$ref": "#/$defs/OpenIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Producer": {
      "description": "The authenticated inventory producer and exact context that determines page-key and digest meaning.",
      "type": "object",
      "additionalProperties": false,
      "required": ["context_digest", "identity", "version"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/ArtifactId"
        },
        "version": {
          "$ref": "#/$defs/OpenIdentity"
        },
        "context_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "SourcePage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "resource_digest"],
      "properties": {
        "key": {
          "$ref": "#/$defs/PageKey"
        },
        "resource_digest": {
          "description": "The exact producer-defined source page resource bytes.",
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "TargetOrigin": {
      "description": "Producer-declared provenance for one observed target page. Authority is established outside this reader. Target-resource optionally names its exact source resource lineage; fallback names its policy class and exact source resource.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["based_on_source_digest", "kind"],
          "properties": {
            "kind": {
              "const": "target-resource"
            },
            "based_on_source_digest": {
              "description": "The exact producer-defined source resource this target resource was based on, or null when the producer has no exact lineage assertion. Equality proves currency of that identity only, not translation quality.",
              "oneOf": [
                {
                  "$ref": "#/$defs/Digest"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "kind", "source_resource_digest"],
          "properties": {
            "kind": {
              "const": "fallback"
            },
            "class": {
              "$ref": "#/$defs/ArtifactId"
            },
            "source_resource_digest": {
              "$ref": "#/$defs/Digest"
            }
          }
        }
      ]
    },
    "TargetPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "origin", "resource_digest"],
      "properties": {
        "key": {
          "$ref": "#/$defs/PageKey"
        },
        "resource_digest": {
          "description": "The exact producer-defined bytes served for this target page.",
          "$ref": "#/$defs/Digest"
        },
        "origin": {
          "$ref": "#/$defs/TargetOrigin"
        }
      }
    },
    "SourceInventory": {
      "description": "The independently bounded source inventory. False completeness retains observed pages but cannot prove that an absent page is absent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "input_digest", "pages"],
      "properties": {
        "input_digest": {
          "description": "The digest of the exact producer input from which this locale inventory was normalized.",
          "$ref": "#/$defs/Digest"
        },
        "complete": {
          "type": "boolean"
        },
        "pages": {
          "description": "A byte-sorted set unique by page key. The strict reader limits source and target to 100,000 rows combined.",
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/SourcePage"
          }
        }
      }
    },
    "TargetInventory": {
      "description": "The independently bounded target inventory. Every observed target page declares its origin; false completeness cannot prove that an absent page is absent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "input_digest", "pages"],
      "properties": {
        "input_digest": {
          "description": "The digest of the exact producer input from which this target inventory was normalized.",
          "$ref": "#/$defs/Digest"
        },
        "complete": {
          "type": "boolean"
        },
        "pages": {
          "description": "A byte-sorted set unique by page key. The strict reader limits source and target to 100,000 rows combined.",
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/TargetPage"
          }
        }
      }
    },
    "EvidencePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docs",
        "plan_payload_digest",
        "producer",
        "schema",
        "scope",
        "source",
        "target"
      ],
      "properties": {
        "schema": {
          "const": "amiss/locale-coverage-evidence-payload"
        },
        "plan_payload_digest": {
          "description": "The payload digest of the exact operator-owned locale coverage plan this evidence answers.",
          "$ref": "#/$defs/Digest"
        },
        "docs": {
          "$ref": "#/$defs/DocsCandidate"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "source": {
          "$ref": "#/$defs/SourceInventory"
        },
        "target": {
          "$ref": "#/$defs/TargetInventory"
        }
      }
    }
  }
}
