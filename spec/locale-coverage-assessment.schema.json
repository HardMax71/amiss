{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amiss:schema:locale-coverage-assessment",
  "title": "Amiss locale coverage assessment",
  "description": "The deterministic offline judgment over one locale coverage plan and optional producer-normalized inventories. Every reported page, fallback status, lineage status, and per-locale product verdict follows exact evidence; incomplete results are explicit lower bounds and can never match.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "payload_digest", "schema"],
  "properties": {
    "schema": {
      "const": "amiss/locale-coverage-assessment-envelope"
    },
    "payload": {
      "$ref": "#/$defs/AssessmentPayload"
    },
    "payload_digest": {
      "description": "The domain-separated digest of the canonical payload bytes under the locale-coverage-assessment payload schema identity.",
      "$ref": "#/$defs/Digest"
    }
  },
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ArtifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "NullableDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "ProducerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "Verdict": {
      "enum": ["matched", "refuted", "unproven"]
    },
    "PageKey": {
      "description": "One opaque stable page identity emitted by the selected producer, not a route inferred by Amiss.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\p{Cc}]+$"
    },
    "Reason": {
      "enum": [
        "evidence-absent",
        "evidence-unbound",
        "producer-mismatch",
        "docs-mismatch",
        "scope-mismatch",
        "source-incomplete",
        "target-incomplete",
        "fallback-unproven",
        "lineage-unproven",
        "source-product-unproven",
        "target-product-unproven",
        "source-missing",
        "target-missing",
        "target-orphaned",
        "fallback-unauthorized",
        "fallback-source-mismatch",
        "lineage-stale",
        "source-product-mismatch",
        "target-product-mismatch"
      ]
    },
    "FallbackStatus": {
      "enum": ["allowed", "unauthorized", "source-mismatch", "source-unproven"]
    },
    "Fallback": {
      "description": "One observed fallback, its producer-declared class, and the policy/source comparison result.",
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "key", "status"],
      "properties": {
        "key": {
          "$ref": "#/$defs/PageKey"
        },
        "class": {
          "$ref": "#/$defs/ArtifactId"
        },
        "status": {
          "$ref": "#/$defs/FallbackStatus"
        }
      }
    },
    "LineageStatus": {
      "enum": ["current", "stale", "unproven"]
    },
    "Lineage": {
      "description": "One observed target-owned page and its exact comparison with the current source resource. Current and stale compare digests; unproven means no exact based-on digest was supplied.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "status"],
      "properties": {
        "key": {
          "$ref": "#/$defs/PageKey"
        },
        "status": {
          "$ref": "#/$defs/LineageStatus"
        }
      }
    },
    "Product": {
      "description": "The independent exact-product comparison for the source and target locale inventories. Matched means URI and digest equal the planned resource; refuted means a different exact resource was observed; unproven means no authenticated resource identity was supplied.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {
          "$ref": "#/$defs/Verdict"
        },
        "target": {
          "$ref": "#/$defs/Verdict"
        }
      }
    },
    "Coverage": {
      "description": "Confirmed page defects plus assessed fallback and target-lineage rows in byte order. False completeness means the rows remain proved but may be a lower bound because evidence was partial or required lineage was absent. The strict reader limits all five arrays to 200,000 rows combined.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "fallbacks",
        "lineage",
        "source_missing",
        "target_missing",
        "target_orphaned"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "source_missing": {
          "description": "Named policy keys proved absent from a complete source inventory.",
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PageKey"
          }
        },
        "target_missing": {
          "description": "Required source keys proved absent from a complete target inventory.",
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PageKey"
          }
        },
        "target_orphaned": {
          "description": "Observed target keys proved absent from a complete source inventory.",
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PageKey"
          }
        },
        "fallbacks": {
          "description": "Every observed target fallback, byte-sorted and unique by page key.",
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/Fallback"
          }
        },
        "lineage": {
          "description": "Every assessed target-owned page with an observed source resource, byte-sorted and unique by page key. Empty when target lineage is not required.",
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/Lineage"
          }
        }
      }
    },
    "AssessmentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "engine",
        "product",
        "reasons",
        "schema",
        "subject",
        "verdict"
      ],
      "properties": {
        "schema": {
          "const": "amiss/locale-coverage-assessment-payload"
        },
        "engine": {
          "description": "The exact offline evaluator that made this judgment.",
          "type": "object",
          "additionalProperties": false,
          "required": ["engine_digest", "engine_version"],
          "properties": {
            "engine_version": {
              "$ref": "#/$defs/ProducerVersion"
            },
            "engine_digest": {
              "$ref": "#/$defs/Digest"
            }
          }
        },
        "subject": {
          "description": "The accepted report, plan, and optional evidence payloads this judgment binds.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_payload_digest",
            "plan_payload_digest",
            "report_payload_digest"
          ],
          "properties": {
            "report_payload_digest": {
              "$ref": "#/$defs/Digest"
            },
            "plan_payload_digest": {
              "$ref": "#/$defs/Digest"
            },
            "evidence_payload_digest": {
              "$ref": "#/$defs/NullableDigest"
            }
          }
        },
        "verdict": {
          "description": "Matched means the policy-scoped comparison is exhaustive and clean; refuted means at least one trusted mismatch or page defect is proved; unproven means no exhaustive clean result or exact refutation is available.",
          "$ref": "#/$defs/Verdict"
        },
        "reasons": {
          "description": "A canonical enum-order set. The strict reader also requires page reasons to correspond exactly to nonempty page sets.",
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Reason"
          }
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "product": {
          "description": "The per-locale comparison with the plan-selected product, or null when product alignment was not selected or the evidence was not eligible for comparison.",
          "oneOf": [
            {
              "$ref": "#/$defs/Product"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "matched"
              }
            }
          },
          "then": {
            "properties": {
              "reasons": {
                "maxItems": 0
              },
              "subject": {
                "properties": {
                  "evidence_payload_digest": {
                    "$ref": "#/$defs/Digest"
                  }
                }
              },
              "coverage": {
                "properties": {
                  "complete": {
                    "const": true
                  },
                  "source_missing": {
                    "maxItems": 0
                  },
                  "target_missing": {
                    "maxItems": 0
                  },
                  "target_orphaned": {
                    "maxItems": 0
                  },
                  "fallbacks": {
                    "items": {
                      "properties": {
                        "status": {
                          "const": "allowed"
                        }
                      }
                    }
                  },
                  "lineage": {
                    "items": {
                      "properties": {
                        "status": {
                          "const": "current"
                        }
                      }
                    }
                  }
                }
              },
              "product": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "const": "matched"
                      },
                      "target": {
                        "const": "matched"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "refuted"
              }
            }
          },
          "then": {
            "properties": {
              "reasons": {
                "minItems": 1,
                "items": {
                  "enum": [
                    "docs-mismatch",
                    "scope-mismatch",
                    "source-missing",
                    "target-missing",
                    "target-orphaned",
                    "fallback-unauthorized",
                    "fallback-source-mismatch",
                    "lineage-stale",
                    "source-product-mismatch",
                    "target-product-mismatch"
                  ]
                }
              },
              "subject": {
                "properties": {
                  "evidence_payload_digest": {
                    "$ref": "#/$defs/Digest"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "unproven"
              }
            }
          },
          "then": {
            "properties": {
              "coverage": {
                "properties": {
                  "source_missing": {
                    "maxItems": 0
                  },
                  "target_missing": {
                    "maxItems": 0
                  },
                  "target_orphaned": {
                    "maxItems": 0
                  }
                }
              }
            },
            "oneOf": [
              {
                "properties": {
                  "reasons": {
                    "const": ["evidence-absent"]
                  },
                  "coverage": {
                    "properties": {
                      "complete": {
                        "const": false
                      },
                      "fallbacks": {
                        "maxItems": 0
                      },
                      "lineage": {
                        "maxItems": 0
                      }
                    }
                  },
                  "product": {
                    "type": "null"
                  },
                  "subject": {
                    "properties": {
                      "evidence_payload_digest": {
                        "type": "null"
                      }
                    }
                  }
                }
              },
              {
                "oneOf": [
                  {
                    "properties": {
                      "reasons": {
                        "const": ["evidence-unbound"]
                      }
                    }
                  },
                  {
                    "properties": {
                      "reasons": {
                        "const": ["producer-mismatch"]
                      }
                    }
                  }
                ],
                "properties": {
                  "coverage": {
                    "properties": {
                      "complete": {
                        "const": false
                      },
                      "fallbacks": {
                        "maxItems": 0
                      },
                      "lineage": {
                        "maxItems": 0
                      }
                    }
                  },
                  "product": {
                    "type": "null"
                  },
                  "subject": {
                    "properties": {
                      "evidence_payload_digest": {
                        "$ref": "#/$defs/Digest"
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "reasons": {
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "enum": [
                        "source-incomplete",
                        "target-incomplete",
                        "fallback-unproven",
                        "lineage-unproven",
                        "source-product-unproven",
                        "target-product-unproven"
                      ]
                    }
                  },
                  "coverage": {
                    "properties": {
                      "fallbacks": {
                        "items": {
                          "properties": {
                            "status": {
                              "enum": ["allowed", "source-unproven"]
                            }
                          }
                        }
                      },
                      "lineage": {
                        "items": {
                          "properties": {
                            "status": {
                              "enum": ["current", "unproven"]
                            }
                          }
                        }
                      }
                    }
                  },
                  "product": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "enum": ["matched", "unproven"]
                          },
                          "target": {
                            "enum": ["matched", "unproven"]
                          }
                        }
                      }
                    ]
                  },
                  "subject": {
                    "properties": {
                      "evidence_payload_digest": {
                        "$ref": "#/$defs/Digest"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
