{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amiss:schema:publication-assessment",
  "title": "Amiss publication assessment",
  "description": "The deterministic offline judgment over one publication plan and optional provider-normalized evidence. Missing, foreign, or wrong-producer evidence stays unproven; only correctly bound evidence can match or refute the planned publication facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "payload_digest", "schema"],
  "properties": {
    "schema": {
      "const": "amiss/publication-assessment-envelope"
    },
    "payload": {
      "$ref": "#/$defs/AssessmentPayload"
    },
    "payload_digest": {
      "description": "The domain-separated digest of the canonical payload bytes under the publication-assessment payload schema identity.",
      "$ref": "#/$defs/Digest"
    }
  },
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "NullableDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "ProducerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "Reason": {
      "enum": [
        "evidence-absent",
        "evidence-unbound",
        "producer-mismatch",
        "docs-mismatch",
        "target-mismatch",
        "site-mismatch",
        "product-mismatch"
      ]
    },
    "AssessmentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "reasons", "schema", "subject", "verdict"],
      "properties": {
        "schema": {
          "const": "amiss/publication-assessment-payload"
        },
        "engine": {
          "description": "The exact offline evaluator that made this judgment.",
          "type": "object",
          "additionalProperties": false,
          "required": ["engine_digest", "engine_version"],
          "properties": {
            "engine_version": {
              "$ref": "#/$defs/ProducerVersion"
            },
            "engine_digest": {
              "$ref": "#/$defs/Digest"
            }
          }
        },
        "subject": {
          "description": "The accepted report, plan, and optional evidence payloads this judgment binds.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_payload_digest",
            "plan_payload_digest",
            "report_payload_digest"
          ],
          "properties": {
            "report_payload_digest": {
              "$ref": "#/$defs/Digest"
            },
            "plan_payload_digest": {
              "$ref": "#/$defs/Digest"
            },
            "evidence_payload_digest": {
              "$ref": "#/$defs/NullableDigest"
            }
          }
        },
        "verdict": {
          "description": "Matched means every trusted observed publication fact equals the plan; refuted means at least one differs; unproven means no suitably bound trusted receipt was available.",
          "enum": ["matched", "refuted", "unproven"]
        },
        "reasons": {
          "description": "A canonical enum-order set. Matched carries none, refuted names each differing fact group, and unproven names the single trust or availability boundary.",
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Reason"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "matched"
              }
            }
          },
          "then": {
            "properties": {
              "reasons": {
                "maxItems": 0
              },
              "subject": {
                "properties": {
                  "evidence_payload_digest": {
                    "$ref": "#/$defs/Digest"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "refuted"
              }
            }
          },
          "then": {
            "properties": {
              "reasons": {
                "minItems": 1,
                "items": {
                  "enum": [
                    "docs-mismatch",
                    "target-mismatch",
                    "site-mismatch",
                    "product-mismatch"
                  ]
                }
              },
              "subject": {
                "properties": {
                  "evidence_payload_digest": {
                    "$ref": "#/$defs/Digest"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "unproven"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "reasons": {
                    "const": ["evidence-absent"]
                  },
                  "subject": {
                    "properties": {
                      "evidence_payload_digest": {
                        "type": "null"
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "reasons": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "enum": ["evidence-unbound", "producer-mismatch"]
                    }
                  },
                  "subject": {
                    "properties": {
                      "evidence_payload_digest": {
                        "$ref": "#/$defs/Digest"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
