{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amiss:schema:scanner-controls-request",
  "title": "Amiss scanner controls request",
  "description": "The rolling external-input request of the wrapper-to-engine wire. It names provider-neutral authority roles, binds trusted time to an explicit provider plus an opaque provider run identity, and carries only controller-acquired semantic evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "organization_floor",
    "debt_snapshot",
    "waiver_bundle",
    "trusted_time",
    "execution_constraint",
    "semantic_evidence"
  ],
  "properties": {
    "schema": {
      "const": "amiss/scanner-controls-request"
    },
    "organization_floor": {
      "oneOf": [
        {
          "$ref": "#/$defs/SuppliedControl",
          "properties": { "value": { "$ref": "#/$defs/OrganizationFloor" } }
        },
        { "type": "null" }
      ]
    },
    "debt_snapshot": {
      "oneOf": [
        {
          "$ref": "#/$defs/SuppliedControl",
          "properties": { "value": { "$ref": "#/$defs/DebtSnapshot" } }
        },
        { "type": "null" }
      ]
    },
    "waiver_bundle": {
      "oneOf": [
        {
          "$ref": "#/$defs/SuppliedControl",
          "properties": { "value": { "$ref": "#/$defs/WaiverBundle" } }
        },
        { "type": "null" }
      ]
    },
    "trusted_time": {
      "oneOf": [{ "$ref": "#/$defs/SuppliedTime" }, { "type": "null" }]
    },
    "execution_constraint": {
      "oneOf": [
        {
          "$ref": "#/$defs/SuppliedControl",
          "properties": { "value": { "$ref": "#/$defs/ExecutionConstraintDescriptor" } }
        },
        { "type": "null" }
      ]
    },
    "semantic_evidence": {
      "description": "Canonical semantic-evidence envelopes paired with the independently planned semantic context each producer must identify.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/SuppliedSemanticEvidence"
      }
    }
  },
  "$defs": {
    "SemanticEvidenceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "payload_digest", "schema"],
      "properties": {
        "schema": {
          "const": "amiss/semantic-evidence-envelope"
        },
        "payload": {
          "$ref": "#/$defs/Payload"
        },
        "payload_digest": {
          "description": "The domain-separated digest of the canonical payload under its schema identity.",
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "observations", "producer", "schema", "subject"],
      "properties": {
        "schema": {
          "const": "amiss/semantic-evidence-payload"
        },
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "producer": {
          "$ref": "#/$defs/Producer"
        },
        "complete": {
          "description": "Whether the producer completed the exact input its input digest names. A consumer may use absence only when its own kind contract requires a complete set and this value is true.",
          "type": "boolean"
        },
        "observations": {
          "description": "Canonical-JSON-sorted unique observations using the closed site, Sphinx label, and record-set models. Unknown kinds and fields are rejected; compiled consumers additionally enforce their producer-specific semantic laws.",
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Observation"
          }
        }
      }
    },
    "Subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_identity_digest", "source_report_payload_digest"],
      "properties": {
        "candidate_identity_digest": {
          "description": "The scanner candidate-identity digest, which already binds repository identity, refs, base and candidate materialization, and forge semantics.",
          "$ref": "#/$defs/Digest"
        },
        "source_report_payload_digest": {
          "description": "The verified report payload this evidence derives from, or null when a producer ran before report construction.",
          "oneOf": [
            { "$ref": "#/$defs/Digest" },
            { "type": "null" }
          ]
        }
      }
    },
    "Producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_digest", "identity", "input_digest", "kind", "version"],
      "properties": {
        "kind": {
          "description": "One of the compiled semantic producer families.",
          "enum": ["sphinx-inventory-set", "site-build", "record-set"]
        },
        "identity": {
          "description": "The stable producer implementation identity within that class.",
          "$ref": "#/$defs/ArtifactId"
        },
        "version": {
          "description": "The producer implementation version.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "context_digest": {
          "description": "The producer-kind-defined semantic context selected independently of runtime evidence, such as a configuration path, publication prefix, locale, and version.",
          "$ref": "#/$defs/Digest"
        },
        "input_digest": {
          "description": "The producer-kind-defined digest of every inventory or completed runtime input needed to interpret completeness and observations.",
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "Observation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchors", "kind", "route", "source"],
          "properties": {
            "kind": { "const": "site-route" },
            "route": { "type": "string" },
            "source": { "$ref": "#/$defs/RepoPath" },
            "anchors": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchors", "kind", "route", "source"],
          "properties": {
            "kind": { "const": "site-generated-route" },
            "route": { "type": "string" },
            "source": {
              "oneOf": [{ "$ref": "#/$defs/RepoPath" }, { "type": "null" }]
            },
            "anchors": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["destination", "kind", "route", "source"],
          "properties": {
            "kind": { "const": "site-redirect" },
            "route": { "type": "string" },
            "source": { "$ref": "#/$defs/RepoPath" },
            "destination": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["entrypoints", "kind", "manifest", "reachable", "root"],
          "properties": {
            "kind": { "const": "site-navigation" },
            "root": {
              "oneOf": [{ "$ref": "#/$defs/RepoPath" }, { "type": "null" }]
            },
            "manifest": { "$ref": "#/$defs/RepoPath" },
            "entrypoints": { "type": "array", "items": { "type": "string" } },
            "reachable": {
              "type": "array",
              "items": { "$ref": "#/$defs/RepoPath" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["destination", "inventory", "kind", "name"],
          "properties": {
            "kind": { "const": "sphinx-label" },
            "inventory": { "$ref": "#/$defs/ArtifactId" },
            "name": { "type": "string" },
            "destination": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "records"],
          "properties": {
            "kind": { "const": "record-set" },
            "name": { "$ref": "#/$defs/ArtifactId" },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "value"],
                "properties": {
                  "key": { "type": "string" },
                  "value": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    },
    "SuppliedSemanticEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_context_digest", "value"],
      "properties": {
        "value": {
          "description": "The exact semantic-evidence envelope under its own schema.",
          "$ref": "#/$defs/SemanticEvidenceEnvelope"
        },
        "expected_context_digest": {
          "description": "The controller-plan-owned context identity the embedded producer must reproduce.",
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "SuppliedControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "expected_digest", "trust_source"],
      "properties": {
        "value": {
          "description": "The concrete control payload. The per-control ceiling applies to its canonical bytes before evaluation.",
          "type": "object"
        },
        "expected_digest": {
          "$ref": "#/$defs/Digest"
        },
        "trust_source": {
          "description": "A closed provider-neutral authority role. Repository-controlled workflows are not an authority.",
          "enum": ["external-required-check", "organization-policy"]
        }
      }
    },
    "SuppliedTime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "expected_digest",
        "provider",
        "provider_run_id",
        "provider_run_attempt"
      ],
      "properties": {
        "value": {
          "description": "The exact trusted-time statement value. Its authority role is fixed: external-required-check.",
          "$ref": "#/$defs/TrustedTimeStatement"
        },
        "expected_digest": {
          "$ref": "#/$defs/Digest"
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "provider_run_id": {
          "$ref": "#/$defs/ProviderRunId"
        },
        "provider_run_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "ProviderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "ProviderRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,126}[A-Za-z0-9])?$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "TrustedTimeStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "controller",
        "repository",
        "ref",
        "candidate_identity_digest",
        "provider",
        "provider_run_id",
        "provider_run_attempt",
        "evaluation_instant",
        "valid_until"
      ],
      "properties": {
        "schema": {
          "const": "amiss/scanner-trusted-time-statement"
        },
        "controller": {
          "const": "external-required-check-clock"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryIdentity"
        },
        "ref": {
          "$ref": "#/$defs/ExactBranchRef"
        },
        "candidate_identity_digest": {
          "$ref": "#/$defs/Digest"
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "provider_run_id": {
          "$ref": "#/$defs/ProviderRunId"
        },
        "provider_run_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "evaluation_instant": {
          "$ref": "#/$defs/UtcInstant"
        },
        "valid_until": {
          "$ref": "#/$defs/UtcInstant"
        }
      }
    },
    "RepositoryIdentity": {
      "type": "object",
      "description": "An opaque caller-canonical host, slash-joined owner segments, and repository name.",
      "additionalProperties": false,
      "required": [
        "host",
        "owner",
        "name"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,98}[a-z0-9])?(?:/[a-z0-9](?:[a-z0-9._-]{0,98}[a-z0-9])?)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^(?!\\.{1,2}$)[a-z0-9._-]{1,100}$"
        }
      }
    },
    "ExactBranchRef": {
      "type": "string",
      "minLength": 12,
      "maxLength": 266,
      "pattern": "^refs/heads/(?!/)(?![\\s\\S]*\\.\\.)(?![\\s\\S]*@\\{)(?![\\s\\S]*[~^:?*\\[\\\\\\u0000-\\u001f\\u007f ])(?!\\.)(?![\\s\\S]*/\\.)(?![^/]*\\.lock(?:/|$))(?![\\s\\S]*/[^/]*\\.lock(?:/|$))(?![\\s\\S]*//)(?![\\s\\S]*/$)(?![\\s\\S]*\\.$).+$"
    },
    "UtcInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "OrganizationFloor": {
      "title": "Amiss external organization floor",
      "description": "A bare, externally acquired, digest-bound semantic policy floor for one repository and exact branch scope. It never embeds debt, waiver, scanner-release, action, status-name, or execution-constraint digests; required execution is independently pinned and cross-bound so release rotation does not invalidate semantic debt.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "floor_id",
        "repository",
        "ref",
        "minimum_profile",
        "minimum_dispositions",
        "protected_inventory",
        "protected_control_paths",
        "waivable_finding_kinds",
        "authorized_debt_owners",
        "authorized_waiver_issuers",
        "resource_limits"
      ],
      "properties": {
        "schema": {
          "const": "amiss/organization-floor"
        },
        "floor_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryIdentity"
        },
        "ref": {
          "$ref": "#/$defs/ExactBranchRef"
        },
        "minimum_profile": {
          "enum": ["observe", "enforce"]
        },
        "minimum_dispositions": {
          "type": "array",
          "maxItems": 3,
          "description": "Sort by finding_kind UTF-8 bytes. Only deterministic scanner finding kinds are promotable.",
          "x-amiss-order": ["finding_kind"],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/FloorDisposition"
          }
        },
        "protected_inventory": {
          "type": "array",
          "maxItems": 100000,
          "description": "Exact paths, sorted by RepoPath UTF-8 bytes.",
          "x-amiss-order": ["RepoPath"],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/RepoPath"
          }
        },
        "protected_control_paths": {
          "type": "array",
          "maxItems": 100000,
          "description": "Exact paths, sorted by RepoPath UTF-8 bytes.",
          "x-amiss-order": ["RepoPath"],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/RepoPath"
          }
        },
        "waivable_finding_kinds": {
          "type": "array",
          "maxItems": 2,
          "description": "Sort by UTF-8 bytes. This is an allow-list, not a pattern language.",
          "x-amiss-order": ["FindingKind"],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/DebtEligibleFindingKind"
          }
        },
        "authorized_debt_owners": {
          "type": "array",
          "maxItems": 10000,
          "description": "Sort by UTF-8 bytes.",
          "x-amiss-order": ["OwnerId"],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/OwnerId"
          }
        },
        "authorized_waiver_issuers": {
          "type": "array",
          "maxItems": 10000,
          "description": "Sort by UTF-8 bytes.",
          "x-amiss-order": ["OwnerId"],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/OwnerId"
          }
        },
        "resource_limits": {
          "type": "array",
          "maxItems": 45,
          "description": "Sort by resource UTF-8 bytes. A floor may only tighten the built-in ceiling.",
          "x-amiss-order": ["resource"],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ResourceLimit"
          }
        }
      }
    },
    "ArtifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "OwnerId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^(team|service|user):[a-z0-9][a-z0-9._/-]*$"
    },
    "RepoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![\\s\\S]*//)(?![\\s\\S]*(?:^|/)(?:\\.{1,2})(?:/|$))(?![\\s\\S]*[\\\\\\u0000])[^/]+(?:/[^/]+)*$"
    },
    "DebtEligibleFindingKind": {
      "enum": ["explicit-target-missing", "explicit-target-type-mismatch"]
    },
    "FloorPromotableFindingKind": {
      "enum": ["explicit-target-missing", "explicit-target-type-mismatch", "invalid-reference"]
    },
    "FloorDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_kind", "disposition"],
      "properties": {
        "finding_kind": {
          "$ref": "#/$defs/FloorPromotableFindingKind"
        },
        "disposition": {
          "enum": ["warn", "fail"]
        }
      }
    },
    "ResourceName": {
      "enum": [
        "git-object-bytes",
        "git-compressed-object-bytes",
        "aggregate-git-compressed-object-bytes-per-evaluation",
        "git-pack-directory-entries",
        "git-pack-files",
        "git-pack-index-bytes",
        "aggregate-git-pack-index-bytes",
        "git-delta-depth",
        "git-index-bytes",
        "git-tree-entries-per-snapshot",
        "documents-per-snapshot",
        "control-input-bytes",
        "selected-control-blob-bytes",
        "aggregate-selected-control-bytes-per-snapshot",
        "repository-policy-entries",
        "debt-items",
        "waiver-items",
        "raw-path-bytes",
        "document-blob-bytes",
        "referenced-target-blob-bytes",
        "aggregate-referenced-target-bytes-per-snapshot",
        "ignore-declaration-blob-bytes",
        "aggregate-ignore-declaration-bytes-per-snapshot",
        "aggregate-line-fragment-evaluation-bytes-per-snapshot",
        "aggregate-heading-anchor-evaluation-bytes-per-snapshot",
        "projection-assertions-per-snapshot",
        "aggregate-projection-selected-bytes-per-snapshot",
        "projection-records-compared-per-snapshot",
        "aggregate-projection-projected-bytes-per-snapshot",
        "aggregate-projection-preview-bytes-per-snapshot",
        "aggregate-document-bytes-per-snapshot",
        "raw-link-destination-bytes",
        "parser-nesting",
        "parser-nodes-per-document",
        "parser-nodes-per-snapshot",
        "aggregate-embedded-code-evaluation-bytes-per-snapshot",
        "references-per-document",
        "references-per-snapshot",
        "declared-labels-per-snapshot",
        "organization-policy-entries",
        "complete-findings",
        "typed-analysis-errors-retained",
        "machine-json-bytes",
        "private-temporary-storage-bytes",
        "evaluator-managed-memory-bytes"
      ]
    },
    "ResourceLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "maximum"],
      "properties": {
        "resource": {
          "$ref": "#/$defs/ResourceName"
        },
        "maximum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resource": {
                "const": "typed-analysis-errors-retained"
              }
            },
            "required": ["resource"]
          },
          "then": {
            "properties": {
              "maximum": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource": {
                "const": "machine-json-bytes"
              }
            },
            "required": ["resource"]
          },
          "then": {
            "properties": {
              "maximum": {
                "type": "integer",
                "minimum": 268435456,
                "maximum": 268435456
              }
            }
          }
        }
      ]
    },
    "DebtSnapshot": {
      "title": "Amiss external adoption-debt snapshot",
      "description": "The rolling externally reviewed exact-fact debt set. It has no magnitude or maximum-measure field: a candidate fact is tolerated only by exact fact-digest equality; absence is resolution.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "repository",
        "ref",
        "organization_floor_digest",
        "adoption_tree",
        "adoption_report_payload_digest",
        "created_at",
        "items"
      ],
      "properties": {
        "schema": {
          "const": "amiss/debt-snapshot"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryIdentity"
        },
        "ref": {
          "$ref": "#/$defs/ExactBranchRef"
        },
        "organization_floor_digest": {
          "$ref": "#/$defs/Digest"
        },
        "adoption_tree": {
          "$ref": "#/$defs/TreeIdentity"
        },
        "adoption_report_payload_digest": {
          "$ref": "#/$defs/Digest"
        },
        "created_at": {
          "$ref": "#/$defs/UtcInstant"
        },
        "items": {
          "type": "array",
          "maxItems": 100000,
          "description": "Sort by debt_id UTF-8 bytes. Debt IDs and finding keys are each globally unique.",
          "x-amiss-order": ["debt_id"],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/DebtItem"
          }
        }
      },
      "$defs": {
        "StructuralFindingFactInput": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "properties": {
                "finding_kind": {
                  "const": "explicit-target-missing"
                },
                "key_input": {
                  "type": "object",
                  "required": ["finding_kind"],
                  "properties": {
                    "finding_kind": {
                      "const": "explicit-target-missing"
                    }
                  }
                },
                "evidence": {
                  "type": "object",
                  "required": ["resolution"],
                  "properties": {
                    "resolution": {
                      "$ref": "#/$defs/MissingResolution"
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "finding_kind": {
                  "const": "explicit-target-type-mismatch"
                },
                "key_input": {
                  "type": "object",
                  "required": ["finding_kind"],
                  "properties": {
                    "finding_kind": {
                      "const": "explicit-target-type-mismatch"
                    }
                  }
                },
                "evidence": {
                  "type": "object",
                  "required": ["resolution"],
                  "properties": {
                    "resolution": {
                      "$ref": "#/$defs/TypeMismatchResolution"
                    }
                  }
                }
              }
            }
          ],
          "required": ["schema", "finding_kind", "key_input", "evidence"],
          "properties": {
            "schema": {
              "const": "amiss/scanner-fact"
            },
            "finding_kind": {
              "$ref": "#/$defs/DebtEligibleFindingKind"
            },
            "key_input": {
              "$ref": "#/$defs/DebtFindingKeyInput"
            },
            "evidence": {
              "$ref": "#/$defs/StructuralFactEvidence"
            }
          }
        }
      }
    },
    "GitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "TreeIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["object_format", "tree_oid"],
          "properties": {
            "object_format": {
              "const": "sha1"
            },
            "tree_oid": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["object_format", "tree_oid"],
          "properties": {
            "object_format": {
              "const": "sha256"
            },
            "tree_oid": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "SourceConstruct": {
      "enum": [
        "markdown-inline-link",
        "markdown-full-reference-link",
        "markdown-collapsed-reference-link",
        "markdown-shortcut-reference-link",
        "markdown-autolink",
        "markdown-inline-image",
        "markdown-full-reference-image",
        "markdown-collapsed-reference-image",
        "markdown-shortcut-reference-image",
        "asciidoc-xref-macro",
        "asciidoc-internal-xref",
        "asciidoc-link-macro",
        "asciidoc-block-image",
        "asciidoc-inline-image",
        "asciidoc-include",
        "rst-inline-hyperlink",
        "rst-named-target",
        "rst-image-directive",
        "rst-include-directive",
        "rst-file-option",
        "markdown-link-reference-definition",
        "html-anchor",
        "html-image"
      ]
    },
    "RepositoryTargetIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "target_kind", "query_digest", "fragment_digest"],
      "properties": {
        "kind": {
          "const": "repository-path"
        },
        "path": {
          "$ref": "#/$defs/RepoPath"
        },
        "target_kind": {
          "enum": ["blob", "tree", "either"]
        },
        "query_digest": {
          "oneOf": [{"$ref":"#/$defs/Digest"},{"type":"null"}]
        },
        "fragment_digest": {
          "oneOf": [{"$ref":"#/$defs/Digest"},{"type":"null"}]
        },
        "commit_oid": {
          "$ref": "#/$defs/GitOid"
        }
      }
    },
    "DebtOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_projection_digest"],
      "properties": {
        "kind": {
          "const": "source-projection"
        },
        "source_projection_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "DebtFindingScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "document", "source_construct", "normalized_target_intent", "occurrence"],
      "properties": {
        "kind": {
          "const": "reference"
        },
        "document": {
          "$ref": "#/$defs/RepoPath"
        },
        "source_construct": {
          "$ref": "#/$defs/SourceConstruct"
        },
        "normalized_target_intent": {
          "$ref": "#/$defs/RepositoryTargetIntent"
        },
        "occurrence": {
          "$ref": "#/$defs/DebtOccurrence"
        }
      }
    },
    "DebtFindingKeyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "finding_kind", "scope"],
      "properties": {
        "schema": {
          "const": "amiss/scanner-finding-key-input"
        },
        "finding_kind": {
          "$ref": "#/$defs/DebtEligibleFindingKind"
        },
        "scope": {
          "$ref": "#/$defs/DebtFindingScope"
        }
      }
    },
    "AvailableResolutionContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "raw_digest", "projection_digest"],
      "properties": {
        "kind": {
          "const": "available"
        },
        "raw_digest": {
          "$ref": "#/$defs/Digest"
        },
        "projection_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "LfsPointerResolutionContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "raw_digest"],
      "properties": {
        "kind": {
          "const": "lfs-pointer"
        },
        "raw_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "ResolutionContent": {
      "oneOf": [{"$ref":"#/$defs/AvailableResolutionContent"},{"$ref":"#/$defs/LfsPointerResolutionContent"}]
    },
    "TreeResolutionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "const": "tree"
        },
        "path": {
          "$ref": "#/$defs/RepoPath"
        }
      }
    },
    "BlobResolutionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "mode", "content"],
      "properties": {
        "kind": {
          "const": "blob"
        },
        "path": {
          "$ref": "#/$defs/RepoPath"
        },
        "mode": {
          "enum": ["100644", "100755"]
        },
        "content": {
          "$ref": "#/$defs/ResolutionContent"
        }
      }
    },
    "ResolutionTarget": {
      "oneOf": [{"$ref":"#/$defs/TreeResolutionTarget"},{"$ref":"#/$defs/BlobResolutionTarget"}]
    },
    "LabelMissingResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": {
          "const": "missing"
        },
        "reason": {
          "enum": ["label-not-declared"]
        }
      }
    },
    "MissingResolution": {
      "oneOf": [
        {
          "$ref": "#/$defs/PathNotFoundResolution"
        },
        {
          "$ref": "#/$defs/PathMissingResolution"
        },
        {
          "$ref": "#/$defs/HeadingMissingResolution"
        },
        {
          "$ref": "#/$defs/LabelMissingResolution"
        }
      ]
    },
    "PathMissingResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "path"],
      "properties": {
        "kind": {
          "const": "missing"
        },
        "reason": {
          "enum": ["line-fragment-out-of-range"]
        },
        "path": {
          "$ref": "#/$defs/RepoPath"
        }
      }
    },
    "PathNotFoundResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "path", "near"],
      "properties": {
        "kind": {
          "const": "missing"
        },
        "reason": {
          "const": "path-not-found"
        },
        "path": {
          "$ref": "#/$defs/RepoPath"
        },
        "near": {
          "oneOf": [{"type":"null"},{"$ref":"#/$defs/RepoPath"}]
        },
        "same_object_at": {
          "oneOf": [{"type":"null"},{"$ref":"#/$defs/RepoPath"}]
        }
      },
      "description": "A path the candidate tree does not hold. Near carries its unique case-only neighbor. Same-object-at optionally carries the candidate-added path in a unique removed/added pair with identical Git mode and object ID; it is evidence of equal bytes, not intent or a repair."
    },
    "HeadingMissingResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "path", "near"],
      "properties": {
        "kind": {
          "const": "missing"
        },
        "reason": {
          "const": "heading-anchor-not-found"
        },
        "path": {
          "$ref": "#/$defs/RepoPath"
        },
        "near": {
          "oneOf": [{"type":"null"},{"type":"string", "minLength":1}]
        }
      },
      "description": "A heading anchor the complete published set refused, carrying the one case-fold neighbor when exactly one exists and null otherwise."
    },
    "TypeMismatchResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": {
          "const": "type-mismatch"
        },
        "target": {
          "$ref": "#/$defs/ResolutionTarget"
        }
      }
    },
    "StructuralResolution": {
      "oneOf": [{"$ref":"#/$defs/MissingResolution"},{"$ref":"#/$defs/TypeMismatchResolution"}]
    },
    "StructuralFactEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resolution", "occurrence_multiplicity"],
      "properties": {
        "kind": {
          "const": "reference"
        },
        "resolution": {
          "$ref": "#/$defs/StructuralResolution"
        },
        "occurrence_multiplicity": {
          "const": 1
        }
      }
    },
    "DebtItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "debt_id",
        "finding_key",
        "accepted_fact",
        "accepted_fact_digest",
        "owner",
        "reason",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "debt_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "finding_key": {
          "$ref": "#/$defs/Digest"
        },
        "accepted_fact_digest": {
          "$ref": "#/$defs/Digest"
        },
        "accepted_fact": {
          "$ref": "#/$defs/DebtSnapshot/$defs/StructuralFindingFactInput"
        },
        "owner": {
          "$ref": "#/$defs/OwnerId"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "created_at": {
          "$ref": "#/$defs/UtcInstant"
        },
        "expires_at": {
          "$ref": "#/$defs/UtcInstant"
        }
      }
    },
    "WaiverBundle": {
      "title": "Amiss external waiver bundle",
      "description": "Externally authorized, exact-key, exact-fact, exact-candidate-tree waivers. Wildcards and indistinguishable duplicate occurrences are unrepresentable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "repository", "ref", "organization_floor_digest", "created_at", "items"],
      "properties": {
        "schema": {
          "const": "amiss/waiver-bundle"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryIdentity"
        },
        "ref": {
          "$ref": "#/$defs/ExactBranchRef"
        },
        "organization_floor_digest": {
          "$ref": "#/$defs/Digest"
        },
        "created_at": {
          "$ref": "#/$defs/UtcInstant"
        },
        "items": {
          "type": "array",
          "maxItems": 100000,
          "description": "Sort by candidate tree object format/OID, finding_key, then waiver_id. Duplicate (candidate_tree, finding_key) pairs and reused waiver IDs are invalid.",
          "x-amiss-order": ["candidate_tree.object_format", "candidate_tree.tree_oid", "finding_key", "waiver_id"],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/WaiverItem"
          }
        }
      },
      "$defs": {
        "StructuralFindingFactInput": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "properties": {
                "finding_kind": {
                  "const": "explicit-target-missing"
                },
                "key_input": {
                  "type": "object",
                  "required": ["finding_kind"],
                  "properties": {
                    "finding_kind": {
                      "const": "explicit-target-missing"
                    }
                  }
                },
                "evidence": {
                  "type": "object",
                  "required": ["resolution"],
                  "properties": {
                    "resolution": {
                      "$ref": "#/$defs/MissingResolution"
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "finding_kind": {
                  "const": "explicit-target-type-mismatch"
                },
                "key_input": {
                  "type": "object",
                  "required": ["finding_kind"],
                  "properties": {
                    "finding_kind": {
                      "const": "explicit-target-type-mismatch"
                    }
                  }
                },
                "evidence": {
                  "type": "object",
                  "required": ["resolution"],
                  "properties": {
                    "resolution": {
                      "$ref": "#/$defs/TypeMismatchResolution"
                    }
                  }
                }
              }
            }
          ],
          "required": ["schema", "finding_kind", "key_input", "evidence"],
          "properties": {
            "schema": {
              "const": "amiss/scanner-fact"
            },
            "finding_kind": {
              "$ref": "#/$defs/WaiverEligibleFindingKind"
            },
            "key_input": {
              "$ref": "#/$defs/WaiverFindingKeyInput"
            },
            "evidence": {
              "$ref": "#/$defs/StructuralFactEvidence"
            }
          }
        }
      }
    },
    "WaiverEligibleFindingKind": {
      "enum": ["explicit-target-missing", "explicit-target-type-mismatch"]
    },
    "WaiverOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_projection_digest"],
      "properties": {
        "kind": {
          "const": "source-projection"
        },
        "source_projection_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "WaiverFindingScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "document", "source_construct", "normalized_target_intent", "occurrence"],
      "properties": {
        "kind": {
          "const": "reference"
        },
        "document": {
          "$ref": "#/$defs/RepoPath"
        },
        "source_construct": {
          "$ref": "#/$defs/SourceConstruct"
        },
        "normalized_target_intent": {
          "$ref": "#/$defs/RepositoryTargetIntent"
        },
        "occurrence": {
          "$ref": "#/$defs/WaiverOccurrence"
        }
      }
    },
    "WaiverFindingKeyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "finding_kind", "scope"],
      "properties": {
        "schema": {
          "const": "amiss/scanner-finding-key-input"
        },
        "finding_kind": {
          "$ref": "#/$defs/WaiverEligibleFindingKind"
        },
        "scope": {
          "$ref": "#/$defs/WaiverFindingScope"
        }
      }
    },
    "WaiverItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waiver_id",
        "finding_key",
        "authorized_fact",
        "authorized_fact_digest",
        "candidate_tree",
        "owner",
        "issuer",
        "reason",
        "created_at",
        "not_before",
        "expires_at",
        "residual_disposition"
      ],
      "properties": {
        "waiver_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "finding_key": {
          "$ref": "#/$defs/Digest"
        },
        "authorized_fact_digest": {
          "$ref": "#/$defs/Digest"
        },
        "authorized_fact": {
          "$ref": "#/$defs/WaiverBundle/$defs/StructuralFindingFactInput"
        },
        "candidate_tree": {
          "$ref": "#/$defs/TreeIdentity"
        },
        "owner": {
          "$ref": "#/$defs/OwnerId"
        },
        "issuer": {
          "$ref": "#/$defs/OwnerId"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "created_at": {
          "$ref": "#/$defs/UtcInstant"
        },
        "not_before": {
          "$ref": "#/$defs/UtcInstant"
        },
        "expires_at": {
          "$ref": "#/$defs/UtcInstant"
        },
        "residual_disposition": {
          "const": "warn"
        }
      }
    },
    "ExecutionConstraintDescriptor": {
      "title": "Amiss execution constraint",
      "description": "The rolling externally protected allow-list entry for one scanner action tree, release manifest, bootstrap contract, platform, and required provider status name.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "action_repository",
        "action_object_format",
        "action_commit_oid",
        "action_tree_oid",
        "manifest_path",
        "release_manifest_digest",
        "selected_platform",
        "required_status_name",
        "bootstrap_contract",
        "bootstrap_digest"
      ],
      "properties": {
        "schema": {
          "const": "amiss/scanner-execution-constraint"
        },
        "action_repository": {
          "$ref": "#/$defs/RepositoryIdentity"
        },
        "action_object_format": {
          "enum": ["sha1", "sha256"]
        },
        "action_commit_oid": {
          "$ref": "#/$defs/ExecutionConstraintDescriptor/$defs/GitOid"
        },
        "action_tree_oid": {
          "$ref": "#/$defs/ExecutionConstraintDescriptor/$defs/GitOid"
        },
        "manifest_path": {
          "$ref": "#/$defs/RepoPath"
        },
        "release_manifest_digest": {
          "$ref": "#/$defs/Digest"
        },
        "selected_platform": {
          "$ref": "#/$defs/Platform"
        },
        "required_status_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9 ._/:-]{0,158}[A-Za-z0-9._/:-])?$"
        },
        "bootstrap_contract": {
          "const": "amiss-action-bootstrap"
        },
        "bootstrap_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action_object_format": {
                "const": "sha1"
              }
            },
            "required": ["action_object_format"]
          },
          "then": {
            "properties": {
              "action_commit_oid": {
                "$ref": "#/$defs/Sha1Oid"
              },
              "action_tree_oid": {
                "$ref": "#/$defs/Sha1Oid"
              }
            }
          },
          "else": {
            "properties": {
              "action_commit_oid": {
                "$ref": "#/$defs/Sha256Oid"
              },
              "action_tree_oid": {
                "$ref": "#/$defs/Sha256Oid"
              }
            }
          }
        }
      ],
      "$defs": {
        "GitOid": {
          "oneOf": [{"$ref":"#/$defs/Sha1Oid"},{"$ref":"#/$defs/Sha256Oid"}]
        }
      }
    },
    "Sha1Oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "Sha256Oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Platform": {
      "enum": [
        "linux-aarch64",
        "linux-x86_64",
        "macos-aarch64",
        "macos-x86_64",
        "windows-aarch64",
        "windows-x86_64"
      ]
    }
  }
}
