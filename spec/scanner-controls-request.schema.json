{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amiss:schema:scanner-controls-request",
  "title": "Amiss scanner controls request",
  "description": "The rolling external-input request of the wrapper-to-engine wire. It names provider-neutral authority roles, binds trusted time to an explicit provider plus an opaque provider run identity, and carries only controller-acquired semantic evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "organization_floor",
    "debt_snapshot",
    "waiver_bundle",
    "trusted_time",
    "execution_constraint",
    "semantic_evidence"
  ],
  "properties": {
    "schema": {
      "const": "amiss/scanner-controls-request"
    },
    "organization_floor": {
      "oneOf": [{ "$ref": "#/$defs/SuppliedControl" }, { "type": "null" }]
    },
    "debt_snapshot": {
      "oneOf": [{ "$ref": "#/$defs/SuppliedControl" }, { "type": "null" }]
    },
    "waiver_bundle": {
      "oneOf": [{ "$ref": "#/$defs/SuppliedControl" }, { "type": "null" }]
    },
    "trusted_time": {
      "oneOf": [{ "$ref": "#/$defs/SuppliedTime" }, { "type": "null" }]
    },
    "execution_constraint": {
      "oneOf": [{ "$ref": "#/$defs/SuppliedControl" }, { "type": "null" }]
    },
    "semantic_evidence": {
      "description": "Canonical semantic-evidence envelopes paired with the independently planned semantic context each producer must identify.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/SuppliedSemanticEvidence"
      }
    }
  },
  "$defs": {
    "SuppliedSemanticEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_context_digest", "value"],
      "properties": {
        "value": {
          "description": "The exact semantic-evidence envelope under its own schema.",
          "type": "object"
        },
        "expected_context_digest": {
          "description": "The controller-plan-owned context identity the embedded producer must reproduce.",
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "SuppliedControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "expected_digest", "trust_source"],
      "properties": {
        "value": {
          "description": "The exact control JSON value under its own schema. The per-control raw ceiling applies to its canonical bytes before typed parsing.",
          "type": "object"
        },
        "expected_digest": {
          "$ref": "#/$defs/Digest"
        },
        "trust_source": {
          "description": "A closed provider-neutral authority role. Repository-controlled workflows are not an authority.",
          "enum": ["external-required-check", "organization-policy"]
        }
      }
    },
    "SuppliedTime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "expected_digest",
        "provider",
        "provider_run_id",
        "provider_run_attempt"
      ],
      "properties": {
        "value": {
          "description": "The exact trusted-time statement value. Its authority role is fixed: external-required-check.",
          "$ref": "#/$defs/TrustedTimeStatement"
        },
        "expected_digest": {
          "$ref": "#/$defs/Digest"
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "provider_run_id": {
          "$ref": "#/$defs/ProviderRunId"
        },
        "provider_run_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "ProviderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "ProviderRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,126}[A-Za-z0-9])?$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "TrustedTimeStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "controller",
        "repository",
        "ref",
        "candidate_identity_digest",
        "provider",
        "provider_run_id",
        "provider_run_attempt",
        "evaluation_instant",
        "valid_until"
      ],
      "properties": {
        "schema": {
          "const": "amiss/scanner-trusted-time-statement"
        },
        "controller": {
          "const": "external-required-check-clock"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryIdentity"
        },
        "ref": {
          "$ref": "#/$defs/ExactBranchRef"
        },
        "candidate_identity_digest": {
          "$ref": "#/$defs/Digest"
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "provider_run_id": {
          "$ref": "#/$defs/ProviderRunId"
        },
        "provider_run_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "evaluation_instant": {
          "$ref": "#/$defs/UtcInstant"
        },
        "valid_until": {
          "$ref": "#/$defs/UtcInstant"
        }
      }
    },
    "RepositoryIdentity": {
      "type": "object",
      "description": "An opaque caller-canonical host, slash-joined owner segments, and repository name.",
      "additionalProperties": false,
      "required": [
        "host",
        "owner",
        "name"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,98}[a-z0-9])?(?:/[a-z0-9](?:[a-z0-9._-]{0,98}[a-z0-9])?)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^(?!\\.{1,2}$)[a-z0-9._-]{1,100}$"
        }
      }
    },
    "ExactBranchRef": {
      "type": "string",
      "minLength": 12,
      "maxLength": 266,
      "pattern": "^refs/heads/(?!/)(?![\\s\\S]*\\.\\.)(?![\\s\\S]*@\\{)(?![\\s\\S]*[~^:?*\\[\\\\\\u0000-\\u001f\\u007f ])(?!\\.)(?![\\s\\S]*/\\.)(?![^/]*\\.lock(?:/|$))(?![\\s\\S]*/[^/]*\\.lock(?:/|$))(?![\\s\\S]*//)(?![\\s\\S]*/$)(?![\\s\\S]*\\.$).+$"
    },
    "UtcInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
