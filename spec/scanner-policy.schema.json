{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:amiss:schema:scanner-policy",
 "title": "Amiss repository scanner policy",
 "description": "The rolling raise-only repository policy read from exactly .amiss/scanner-policy.json.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "document_includes",
  "protected_inventory",
  "finding_dispositions"
 ],
 "properties": {
  "schema": {
   "const": "amiss/scanner-policy"
  },
  "document_includes": {
   "type": "array",
   "maxItems": 100000,
   "description": "Exact repository paths only. Sort by path UTF-8 bytes, then kind; that pair is the stable selector identity. A tree entry may narrow itself to one exact suffix and may bind one built-in adapter.",
   "x-amiss-order": [
    "path",
    "kind"
   ],
   "uniqueItems": true,
   "items": {
    "$ref": "#/$defs/DocumentInclude"
   }
  },
  "projection_assertions": {
   "type": "array",
   "maxItems": 100000,
   "description": "Policy-owned source-to-document relations. Sort by document UTF-8 bytes, then name; that pair is the stable assertion identity.",
   "x-amiss-order": [
    "document",
    "name"
   ],
   "uniqueItems": true,
   "items": {
    "$ref": "#/$defs/ProjectionAssertion"
   }
  },
  "protected_inventory": {
   "type": "array",
   "maxItems": 100000,
   "description": "Exact document paths only. Sort by RepoPath UTF-8 bytes.",
   "x-amiss-order": [
    "RepoPath"
   ],
   "uniqueItems": true,
   "items": {
    "$ref": "#/$defs/RepoPath"
   }
  },
  "finding_dispositions": {
   "type": "array",
   "maxItems": 3,
   "description": "Raise-only overrides. Sort by finding_kind UTF-8 bytes.",
   "x-amiss-order": [
    "finding_kind"
   ],
   "uniqueItems": true,
   "items": {
    "$ref": "#/$defs/FindingDisposition"
   }
  }
 },
 "$defs": {
  "RepoPath": {
   "type": "string",
   "minLength": 1,
   "maxLength": 4096,
   "pattern": "^(?!/)(?![\\s\\S]*//)(?![\\s\\S]*(?:^|/)(?:\\.{1,2})(?:/|$))(?![\\s\\S]*[\\\\\\u0000])[^/]+(?:/[^/]+)*$",
   "description": "Strict UTF-8 repository-relative path using slash separators; byte limits and UTF-8 validity are additionally enforced before JSON decoding."
  },
  "DocumentInclude": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "kind"
   ],
   "properties": {
    "path": {
     "$ref": "#/$defs/RepoPath"
    },
    "kind": {
     "enum": [
      "document",
      "tree"
     ]
    },
    "suffix": {
     "$ref": "#/$defs/ExactSuffix"
    },
    "adapter": {
     "enum": [
      "asciidoc",
      "markdown",
      "mdx",
      "plain-advisory",
      "rst"
     ],
     "description": "Reads the included path under this built-in grammar. Only paths outside the built-in classification rows take a binding; the effective map is the candidate side's policy, or the base side's when the candidate carries none."
    }
   },
   "allOf": [
    {
     "if": {
      "required": [
       "suffix"
      ]
     },
     "then": {
      "properties": {
       "kind": {
        "const": "tree"
       }
      }
     }
    }
   ]
  },
  "ExactSuffix": {
   "type": "string",
   "minLength": 2,
   "maxLength": 64,
   "pattern": "^\\.[^/\\\\\\u0000]+$",
   "description": "Optional exact UTF-8 suffix for a tree selector. The Rust reader additionally caps its UTF-8 encoding at 64 bytes. No glob, wildcard, regex, normalization, or case folding is applied."
  },
  "PositiveSafeUInt": {
   "type": "integer",
   "minimum": 1,
   "maximum": 9007199254740991
  },
  "BlobLineSelection": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "path",
    "first_line",
    "last_line"
   ],
   "properties": {
    "kind": {
     "const": "blob-lines"
    },
    "path": {
     "$ref": "#/$defs/RepoPath"
    },
    "first_line": {
     "$ref": "#/$defs/PositiveSafeUInt"
    },
    "last_line": {
     "$ref": "#/$defs/PositiveSafeUInt"
    }
   }
  },
  "SourceMarker": {
   "type": "string",
   "minLength": 1,
   "maxLength": 256,
   "pattern": "^[ -~]*[!-~][ -~]*$"
  },
  "NamedRegionSelection": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "path",
    "start_marker",
    "end_marker"
   ],
   "properties": {
    "kind": {
     "const": "named-region"
    },
    "path": {
     "$ref": "#/$defs/RepoPath"
    },
    "start_marker": {
     "$ref": "#/$defs/SourceMarker"
    },
    "end_marker": {
     "$ref": "#/$defs/SourceMarker"
    }
   }
  },
  "TreePathSelection": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "root",
    "maximum_depth"
   ],
   "properties": {
    "kind": {
     "const": "tree-paths"
    },
    "root": {
     "$ref": "#/$defs/RepoPath"
    },
    "suffix": {
     "$ref": "#/$defs/ExactSuffix"
    },
    "maximum_depth": {
     "$ref": "#/$defs/PositiveSafeUInt"
    }
   }
  },
  "CodeTextSource": {
   "oneOf": [
    {
     "$ref": "#/$defs/BlobLineSelection"
    },
    {
     "$ref": "#/$defs/NamedRegionSelection"
    }
   ]
  },
  "ProjectionSource": {
   "oneOf": [
    {
     "$ref": "#/$defs/BlobLineSelection"
    },
    {
     "$ref": "#/$defs/NamedRegionSelection"
    },
    {
     "$ref": "#/$defs/TreePathSelection"
    }
   ]
  },
  "ProjectionAssertion": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "document",
    "name",
    "projection",
    "sink",
    "source"
   ],
   "properties": {
    "document": {
     "$ref": "#/$defs/RepoPath"
    },
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 120,
     "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "projection": {
     "enum": [
     "code-text-v1",
      "sorted-rows-v1",
      "decimal-count-v1"
     ]
    },
    "sink": {
     "const": "previous-code"
    },
    "source": {
     "$ref": "#/$defs/ProjectionSource"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "projection": {
        "const": "code-text-v1"
       }
      }
     },
     "then": {
      "properties": {
       "source": {
        "$ref": "#/$defs/CodeTextSource"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "projection": {
        "enum": [
         "sorted-rows-v1",
         "decimal-count-v1"
        ]
       }
      }
     },
     "then": {
      "properties": {
       "source": {
        "$ref": "#/$defs/TreePathSelection"
       }
      }
     }
    }
   ]
  },
  "FindingKind": {
   "enum": [
    "explicit-target-missing",
    "explicit-target-type-mismatch",
    "invalid-reference"
   ]
  },
  "FindingDisposition": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "finding_kind",
    "disposition"
   ],
   "properties": {
    "finding_kind": {
     "$ref": "#/$defs/FindingKind"
    },
    "disposition": {
     "enum": [
      "warn",
      "fail"
     ]
    }
   }
  }
 }
}
