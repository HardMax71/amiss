{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amiss:schema:scanner-external-assessment",
  "title": "Amiss external assessment",
  "description": "The pure judgment `amiss external-assess` makes over one external plan and one evidence file: every introduced destination carries a verdict under the engine's fixed policy, and the subject block binds report, plan, and evidence digests so the whole chain replays. Advisory by design: the artifact carries data and no exit-one verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "payload_digest", "schema"],
  "properties": {
    "schema": {
      "const": "amiss/external-assessment-envelope"
    },
    "payload": {
      "$ref": "#/$defs/AssessmentPayload"
    },
    "payload_digest": {
      "description": "The domain-separated digest of the canonical payload bytes, under the payload schema identity as its domain.",
      "$ref": "#/$defs/Digest"
    }
  },
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "AssessmentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "producer", "schema", "subject", "verdicts"],
      "properties": {
        "schema": {
          "const": "amiss/external-assessment-payload"
        },
        "engine": {
          "description": "The provenance of the binary that judged.",
          "type": "object",
          "additionalProperties": false,
          "required": ["engine_digest", "engine_version"],
          "properties": {
            "engine_version": {
              "type": "string",
              "minLength": 1
            },
            "engine_digest": {
              "$ref": "#/$defs/Digest"
            }
          }
        },
        "subject": {
          "description": "The exact inputs this judgment binds: the report the plan derived from, the plan itself, and the evidence file, each by digest.",
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence_digest", "plan_payload_digest", "report_payload_digest"],
          "properties": {
            "report_payload_digest": {
              "$ref": "#/$defs/Digest"
            },
            "plan_payload_digest": {
              "$ref": "#/$defs/Digest"
            },
            "evidence_digest": {
              "description": "The domain-separated digest of the evidence value under its schema identity, computed by the judge, so producers never compute digests.",
              "$ref": "#/$defs/Digest"
            }
          }
        },
        "producer": {
          "description": "The evidence file's producer block, echoed.",
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "verdicts": {
          "description": "One row per introduced destination, in the plan's own order.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Verdict"
          }
        }
      }
    },
    "Verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "documents", "verdict"],
      "properties": {
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "documents": {
          "description": "The plan row's documents, echoed.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verdict": {
          "description": "refuted only on proof: a get-confirmed 404 or 410, or a path or revision absent from a readable repository. Denial, rate limits, transport failure, and absent evidence stay unproven, and reachable never claims the content is right.",
          "enum": ["reachable", "refuted", "unproven"]
        },
        "reason": {
          "description": "Why the verdict is not plain reachability; absent exactly there.",
          "enum": [
            "gone",
            "path-missing",
            "revision-missing",
            "unexamined",
            "denied",
            "rate-limited",
            "unavailable",
            "unconfirmed",
            "unfollowed",
            "repository-unseen"
          ]
        },
        "retarget": {
          "description": "Where redirects ended when the probe was moved: a suggestion, never a finding.",
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "reachable"
              }
            }
          },
          "then": {
            "not": {
              "required": ["reason"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "enum": ["refuted", "unproven"]
              }
            }
          },
          "then": {
            "required": ["reason"]
          }
        }
      ]
    }
  }
}
