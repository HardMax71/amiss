{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amiss:schema:scanner-semantic-template",
  "title": "Amiss semantic evidence template",
  "description": "One self-asserted producer's bounded candidate-independent observations. The scanner binds the template to the exact candidate identity during evaluation; the template has no subject field and authenticates nothing by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["complete", "observations", "producer", "schema"],
  "properties": {
    "schema": {
      "const": "amiss/semantic-evidence-template"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "complete": {
      "description": "Whether the producer completed the exact input its input digest names. A consumer may use absence only when its own kind contract requires a complete set and this value is true.",
      "type": "boolean"
    },
    "observations": {
      "description": "Canonical-JSON-sorted unique observations using the closed site, Sphinx label, and record-set models. Unknown kinds and fields are rejected; compiled consumers additionally enforce their producer-specific semantic laws.",
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Observation"
      }
    }
  },
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "Producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_digest", "identity", "input_digest", "kind", "version"],
      "properties": {
        "kind": {
          "description": "One of the compiled semantic producer families.",
          "enum": ["sphinx-inventory-set", "site-build", "record-set"]
        },
        "identity": {
          "description": "The stable producer implementation identity within that class.",
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "description": "The producer implementation version.",
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "context_digest": {
          "description": "The producer-kind-defined semantic context selected by this self-asserted input.",
          "$ref": "#/$defs/Digest"
        },
        "input_digest": {
          "description": "The producer-kind-defined digest of every inventory or completed runtime input needed to interpret completeness and observations.",
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "Observation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchors", "kind", "route", "source"],
          "properties": {
            "kind": { "const": "site-route" },
            "route": { "type": "string" },
            "source": { "$ref": "#/$defs/RepoPathText" },
            "anchors": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["anchors", "kind", "route", "source"],
          "properties": {
            "kind": { "const": "site-generated-route" },
            "route": { "type": "string" },
            "source": {
              "oneOf": [{ "$ref": "#/$defs/RepoPathText" }, { "type": "null" }]
            },
            "anchors": { "type": "array", "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["destination", "kind", "route", "source"],
          "properties": {
            "kind": { "const": "site-redirect" },
            "route": { "type": "string" },
            "source": { "$ref": "#/$defs/RepoPathText" },
            "destination": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["entrypoints", "kind", "manifest", "reachable", "root"],
          "properties": {
            "kind": { "const": "site-navigation" },
            "root": {
              "oneOf": [{ "$ref": "#/$defs/RepoPathText" }, { "type": "null" }]
            },
            "manifest": { "$ref": "#/$defs/RepoPathText" },
            "entrypoints": { "type": "array", "items": { "type": "string" } },
            "reachable": {
              "type": "array",
              "items": { "$ref": "#/$defs/RepoPathText" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["destination", "inventory", "kind", "name"],
          "properties": {
            "kind": { "const": "sphinx-label" },
            "inventory": { "$ref": "#/$defs/Identifier" },
            "name": { "type": "string" },
            "destination": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "records"],
          "properties": {
            "kind": { "const": "record-set" },
            "name": { "$ref": "#/$defs/Identifier" },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "value"],
                "properties": {
                  "key": { "type": "string" },
                  "value": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    },
    "RepoPathText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![\\s\\S]*//)(?![\\s\\S]*(?:^|/)(?:\\.{1,2})(?:/|$))(?![\\s\\S]*[\\\\\\u0000])[^/]+(?:/[^/]+)*$"
    }
  }
}
