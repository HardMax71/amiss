{
  "schema": "amiss/route-spelling-vectors",
  "contract": "route-spelling",
  "reference": "Which source file a documentation router serves for a written destination. Every verdict was harvested from the router itself over the tree below, one destination per probe page, and never transcribed from documentation.",
