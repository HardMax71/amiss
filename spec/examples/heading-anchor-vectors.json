{
  "schema": "amiss/heading-anchor-vectors",
  "contract": "heading-anchor",
  "reference": {
    "harvested": "2026-07-26",
    "note": "Every expectation below was produced by the named implementation, not by this repository. A rule with no live pair is marked as transcribed.",
    "rules": [
      {
        "name": "github",
        "serves": [
          "github.com",
          "GitLab",
          "Docusaurus",
          "Hugo with autoHeadingIDType github"
        ],
        "expectations": "github-slugger 2.0.0 under node 22.22.1",
        "cross_checked": "comrak 0.54.0, the engine gitlab-glfm-markdown wraps, agrees on all 9049 headings harvested from ten public repositories",
        "source": "https://github.com/Flet/github-slugger/blob/main/index.js"
      },
      {
        "name": "gitea",
        "serves": [
          "Gitea 1.27 repository files and wiki pages"
        ],
        "expectations": "transcribed from modules/markup/common/footnote.go CleanValue and modules/markup/html_node.go",
        "cross_checked": "the fifty identities gitea.com publishes for gitea/awesome-gitea",
        "source": "https://github.com/go-gitea/gitea/blob/main/modules/markup/common/footnote.go"
      },
      {
        "name": "forgejo",
        "serves": [
          "Forgejo 16 repository files and wiki pages"
        ],
        "expectations": "transcribed from modules/markup/markdown/prefixed_id.go",
        "cross_checked": "none; no live pair is pinned",
        "source": "https://codeberg.org/forgejo/forgejo/src/branch/forgejo/modules/markup/markdown/prefixed_id.go"
      },
      {
        "name": "mdbook",
        "serves": [
          "mdBook with smart punctuation off"
        ],
        "expectations": "mdbook 0.5.4 rendering one chapter per case",
        "source": "https://github.com/rust-lang/mdBook/blob/master/crates/mdbook-html/src/utils.rs"
      },
      {
        "name": "mdbook-smart",
        "serves": [
          "mdBook with its default smart punctuation"
        ],
        "expectations": "mdbook 0.5.4 rendering one chapter per case",
        "source": "https://github.com/rust-lang/mdBook/blob/master/crates/mdbook-html/src/utils.rs"
      },
      {
        "name": "goldmark",
        "serves": [
          "goldmark embedders that keep its own heading ids"
        ],
        "expectations": "goldmark 1.8.4 under go, reading the id it emits",
        "source": "https://github.com/yuin/goldmark/blob/master/parser/parser.go"
      },
      {
        "name": "python-markdown",
        "serves": [
          "MkDocs with the default toc slug"
        ],
        "expectations": "python-markdown 3.10 toc.slugify and toc.unique",
        "source": "https://github.com/Python-Markdown/markdown/blob/master/markdown/extensions/toc.py"
      },
      {
        "name": "pymdownx",
        "serves": [
          "MkDocs configured with pymdownx.slugs.slugify(case=lower)"
        ],
        "expectations": "pymdownx slugs, transcribed and executed under the same python",
        "source": "https://github.com/facelessuser/pymdown-extensions/blob/main/pymdownx/slugs.py"
      },
      {
        "name": "mdit-vue",
        "serves": [
          "VitePress",
          "VuePress"
        ],
        "expectations": "@mdit-vue/shared slugify under node 22.22.1",
        "source": "https://github.com/mdit-vue/mdit-vue/blob/main/packages/shared/src/slugify.ts"
      },
      {
        "name": "kramdown",
        "serves": [
          "Jekyll",
          "GitHub Pages"
        ],
        "expectations": "transcribed from converter/base.rb and executed under ruby",
        "cross_checked": "none; no live pair is pinned",
        "source": "https://github.com/gettalong/kramdown/blob/master/lib/kramdown/converter/base.rb"
      }
    ]
  },
